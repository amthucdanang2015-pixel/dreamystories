          }
        }
      ]
    },
    {
      "sentences": [
        {
          "en": "An old turtle swam by and smiled kindly.",
          "vi": "Một bác rùa già bơi ngang qua và mỉm cười hiền hậu.",
          "audio": {
            "en": "ca-vang-dem-sao/page-03/sentence-01-en.mp3",
